rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Salons apéruno : lecture/écriture réservées aux utilisateurs
    // (anonymes) authentifiés. Suffisant pour un jeu de soirée entre amis.
    match /rooms/{code} {
      allow read, write: if request.auth != null;
    }
  }
}
