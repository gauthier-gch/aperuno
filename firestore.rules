rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Salons apéruno (+ sous-collection de présence) : lecture/écriture
    // réservées aux utilisateurs (anonymes) authentifiés.
    match /rooms/{code}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
